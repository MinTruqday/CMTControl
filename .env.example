# Target under test
QA_ENV=local
# Website URL for browser/UI/E2E/visual/public HTTP tests.
BASE_URL=
# Complete JSON health endpoint, e.g. https://api.example.com/health.
# Full API coverage additionally requires OpenAPI/Swagger or a Postman collection.
API_BASE_URL=

# Local QA control UI only; this is not the target/API port.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000

# Optional role-access test. Keep secrets only in .env, never in the JSON spec.
ROLE_TEST_ENABLED=false
ROLE_TEST_SPEC_FILE=config/role-access.example.json
QA_ADMIN_USERNAME=
QA_ADMIN_PASSWORD=

# Test execution and failure evidence
HEADLESS=true
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true
VISUAL_TEST_ENABLED=true
REPORT_OUTPUT_DIR=reports/current
EVIDENCE_OUTPUT_DIR=evidence
EVIDENCE_STORAGE_TYPE=local
EVIDENCE_STORAGE_URL=evidence
EVIDENCE_CREATE_RUN_FOLDER=true

# Optional local AI analysis
AI_ANALYSIS_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Optional Google Sheets integration; disabled by default
SHEET_SYNC_ENABLED=false
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secret/google-service-account.json
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
SHEET_EMBED_IMAGES=false
SHEET_IMAGE_MODE=link
SHEET_MASTER_THUMBNAIL=false
TESTER_NAME=
BUG_INITIAL_STATUS=Chờ đối ứng

# Optional dashboard storage
MONGODB_URL=mongodb://127.0.0.1:27017/qa_control

# Safety controls
SOURCE_ANALYSIS_ENABLED=true
SOURCE_WRITE_ENABLED=false
QA_TIMEZONE=Asia/Ho_Chi_Minh
